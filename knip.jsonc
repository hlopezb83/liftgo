{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    // Limpieza manual documentada; nunca se ejecuta durante el análisis.
    "scripts/cleanup-e2e.ts",
    // Verificaciones locales y archivos lanzados como argumentos de subprocess.
    "scripts/tests/obsolete-vat.postgres.mjs",
    "scripts/tests/sale-quote-guard-model.mjs",
    "scripts/tests/fiscal/vitest.config.ts",
    "scripts/tests/contract-deposit/deposit.integration.mjs",
    "scripts/tests/contract-deposit/run-local-postgres.mjs",
    "scripts/tests/deliveries-page/deliveries.integration.mjs",
    "scripts/tests/deliveries-page/run-local-postgres.mjs",
    "scripts/tests/inventory/inventory-page.integration.mjs",
    "scripts/tests/maintenance/consumption-concurrency.mjs",
    "scripts/tests/operations/run-completed-recurring-lifecycle.cjs",
    "scripts/tests/operations/run-operational-corrections.mjs",
    "scripts/tests/quotes/quotes-page.integration.mjs",
    // Edge functions desplegadas en Supabase: son entrypoints propios,
    // no las importa src/ (cron, webhooks y llamadas invoke las referencian).
    "supabase/functions/**/index.ts",
    "supabase/functions/**/handler.ts",
    "supabase/functions/**/*_test.ts"
  ],
  "project": ["src/**", "scripts/**", "supabase/functions/**"],
  "ignoreFiles": [
    // TypeScript resuelve estas declaraciones al importar el .mjs homónimo.
    "scripts/browser-test-config.d.mts",
    "scripts/gen-version.d.mts",
    "scripts/release-identity.d.mts"
  ],
  "ignore": [
    "src/components/ui/**",
    "supabase/functions/_shared/**",
    "src/integrations/supabase/types.ts"
  ],
  "ignoreDependencies": [
    // Deno resolves these assertions through its import map and lockfile.
    "@std/assert",
    // Pin de seguridad transitivo de TanStack; probado por test:dependencies.
    // Retirar cuando sus padres exijan Seroval corregido (docs/security/).
    "seroval",
    "seroval-plugins",
    // drizzle-kit carga el ORM en tiempo de ejecución para `migrate` (CI RLS/A-B).
    "drizzle-orm",
    "@tailwindcss/postcss"
  ],
  "ignoreIssues": {
    // These contract tests inspect intentional transitive resolutions.
    "scripts/tests/dependency-security.test.mjs": ["unlisted"],
    // Deno's npm: specifier is resolved by the Edge runtime.
    "supabase/functions/validate-supplier-rep/handler.ts": ["unlisted"]
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "binaries": "error"
  }
}
