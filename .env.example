# Si todavía no existe .env, copia este archivo y llena los valores del proyecto.
# Navegador: usa la clave pública publishable (o anon heredada), nunca una secreta.
VITE_SUPABASE_PROJECT_ID="tu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="tu-publishable-key"
VITE_SUPABASE_URL="https://tu-project-id.supabase.co"

# Server functions autenticadas: misma URL y clave pública que las VITE_*.
# El middleware del servidor lee estas variables sin el prefijo VITE_.
SUPABASE_URL="https://tu-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="tu-publishable-key"

# Opcional para operaciones administrativas que usan el cliente privilegiado.
# Es una clave secreta sólo del servidor; no se necesita para mostrar el login.
# Nunca le añadas el prefijo VITE_ ni la uses como clave pública.
# SUPABASE_SERVICE_ROLE_KEY="tu-clave-secreta-solo-servidor"
