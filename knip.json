{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    // TanStack Start: entradas reales del build SSR (router/start/server).
    "src/router.tsx",
    "src/start.ts",
    "src/server.ts",
    // Edge functions desplegadas en Supabase: son entrypoints propios,
    // no las importa src/ (cron, webhooks y llamadas invoke las referencian).
    "supabase/functions/**/index.ts",
    "supabase/functions/**/handler.ts",
    "supabase/functions/**/*_test.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ],
  "project": ["src/**", "scripts/**", "supabase/functions/**"],
  "ignore": [
    "src/components/ui/**",
    "supabase/functions/_shared/**",
    "supabase/tests/**"
  ],
  "ignoreDependencies": [
    "lovable-tagger",
    "tailwindcss-animate",
    "tw-animate-css",
    "@tailwindcss/vite",
    "vitest-sonner-reporter",
    "@vitest/coverage-v8",
    "wrangler",
    "@radix-ui/react-aspect-ratio",
    "@radix-ui/react-avatar",
    "@radix-ui/react-context-menu",
    "@radix-ui/react-hover-card",
    "@radix-ui/react-menubar",
    "@radix-ui/react-navigation-menu",
    "@radix-ui/react-progress",
    "@radix-ui/react-radio-group",
    "@radix-ui/react-slider",
    "embla-carousel-react",
    "input-otp",
    "react-resizable-panels",
    "vaul",
    "@babel/core",
    "@rolldown/plugin-babel",
    "@tailwindcss/postcss",
    "@types/babel__core",
    "babel-plugin-react-compiler",
    "eslint-plugin-import-x",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-playwright",
    "eslint-plugin-react-compiler"
  ],
  "ignoreBinaries": ["knip", "tsc", "tsx", "wrangler"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "binaries": "error"
  }
}
