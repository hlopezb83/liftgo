{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    // TanStack Start: entradas reales del build SSR (router/start/server).
    "src/router.tsx",
    "src/start.ts",
    "src/server.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ],
  "project": ["src/**", "scripts/**", "supabase/functions/**"],
  "ignore": [
    "src/components/ui/**",
    "supabase/functions/_shared/**",
    "supabase/tests/**"
  ],
  "ignoreDependencies": [
    "lovable-tagger",
    "tailwindcss-animate",
    "tw-animate-css",
    "@tailwindcss/vite",
    "vitest-sonner-reporter",
    "@vitest/coverage-v8",
    "wrangler"
  ],
  "ignoreBinaries": ["knip", "tsc", "tsx", "wrangler"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "binaries": "error"
  }
}
